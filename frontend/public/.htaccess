Options -MultiViews
RewriteEngine On
RewriteBase /

# Let Apache serve existing assets and files as-is.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Client-side routes (including /admin/settings and /admin/users) use React Router.
RewriteRule ^ index.html [L]
